-- ===================== ESP LOGIC =====================
local function update_esp()
    if not config.esp_enabled then
        for _, d in pairs(drawing_objects) do
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
        end
        return
    end

    for plr, d in pairs(drawing_objects) do
        local show = plr.Parent and is_alive(plr)
        if show and config.esp_team_check and same_team(plr, LocalPlayer) then show = false end

        if not show then
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
            continue
        end

        local head = plr.Character:FindFirstChild("Head")
        local root = plr.Character:FindFirstChild("HumanoidRootPart")
        local hum = plr.Character:FindFirstChildOfClass("Humanoid")
        if not head or not root or not hum then continue end

        local top, top_on = Camera:WorldToViewportPoint(head.Position + Vector3.new(0, 0.8, 0))
        local bottom, bottom_on = Camera:WorldToViewportPoint(root.Position - Vector3.new(0, 2.5, 0))
        
        if not (top_on or bottom_on) then
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
            continue
        end

        local height = math.abs(bottom.Y - top.Y)
        local width = height * 0.55
        local x = math.min(top.X, bottom.X) - width / 2
        local y = math.min(top.Y, bottom.Y)

        if config.esp_box then
            d.box.Size = Vector2.new(width, height)
            d.box.Position = Vector2.new(x, y)
            d.box.Color = config.accent
            d.box.Visible = true
        else d.box.Visible = false end

        if config.esp_health then
            local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
            local bar_h = height * pct
            d.hp_bg.Size = Vector2.new(3, height)
            d.hp_bg.Position = Vector2.new(x - 6, y)
            d.hp_bar.Size = Vector2.new(3, bar_h)
            d.hp_bar.Position = Vector2.new(x - 6, y + (height - bar_h))
            d.hp_bg.Visible = true
            d.hp_bar.Visible = true
        else
            d.hp_bg.Visible = false
            d.hp_bar.Visible = false
        end

        if config.esp_name then
            d.name.Text = plr.Name
            d.name.Position = Vector2.new(x + width / 2, y - 16)
            d.name.Color = config.text
            d.name.Visible = true
        else d.name.Visible = false end

        if config.esp_distance then
            d.dist.Text = string.format("%dm", math.floor((root.Position - Camera.CFrame.Position).Magnitude))
            d.dist.Position = Vector2.new(x + width / 2, y + height + 4)
            d.dist.Color = Color3.fromRGB(200, 190, 220)
            d.dist.Visible = true
        else d.dist.Visible = false end
    end
end

-- ===================== AIMBOT LOGIC =====================
local function get_target()
    local center = Camera.ViewportSize / 2
    local best, best_dist = nil, config.aim_fov
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and is_alive(plr) then
            if not (config.aim_team_check and same_team(plr, LocalPlayer)) then
                local hitbox = get_hitbox(plr.Character)
                if hitbox then
                    local sp, on = Camera:WorldToViewportPoint(hitbox.Position)
                    if on and sp.Z > 0 and has_los(plr.Character, hitbox) then
                        local dist = (Vector2.new(sp.X, sp.Y) - center).Magnitude
                        if dist < best_dist then
                            best, best_dist = { part = hitbox, root = plr.Character:FindFirstChild("HumanoidRootPart") }, dist
                        end
                    end
                end
            end
        end
    end
    return best
end

-- Prioridade máxima para vencer a câmera do jogo
RunService:BindToRenderStep("XynAim", Enum.RenderPriority.Camera.Value + 100, function()
    local mouse_on_gui = is_mouse_over_gui()
    
    if fov_circle then
        fov_circle.Position = Camera.ViewportSize / 2
        fov_circle.Radius = config.aim_fov
        fov_circle.Visible = config.aim_enabled and not mouse_on_gui
        fov_circle.Color = config.accent
    end

    -- Zera o offset do ombro (se houver) para centralizar a mira
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if config.aim_enabled and hum then
        pcall(function() hum.CameraOffset = Vector3.new(0, 0, 0) end)
    end

    if config.aim_enabled and not mouse_on_gui then
        local t = get_target()
        if t then
            local target_pos = t.part.Position
            if config.aim_prediction > 0 and t.root then
                target_pos = target_pos + (t.root.AssemblyLinearVelocity * config.aim_prediction)
            end
            
            local target_cf = CFrame.lookAt(Camera.CFrame.Position, target_pos)
            if config.aim_smooth >= 1.0 then
                Camera.CFrame = target_cf
            else
                Camera.CFrame = Camera.CFrame:Lerp(target_cf, config.aim_smooth)
            end
        end
    end
end)

