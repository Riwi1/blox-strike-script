-- ===================== TARGETING =====================
local function get_closest_target()
    local center = Camera.ViewportSize / 2
    local best, best_dist = nil, S.fov
    
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and is_alive(plr) then
            if not (S.team_check and same_team(plr, LocalPlayer)) then
                local part = get_part(plr, S.aim_part)
                if part then
                    local sp, on = world_to_screen(part.Position)
                    if on and has_los(plr.Character, part) then
                        local dist = (sp - center).Magnitude
                        if dist < best_dist then
                            best, best_dist = { plr = plr, part = part, root = plr.Character:FindFirstChild("HumanoidRootPart") }, dist
                        end
                    end
                end
            end
        end
    end
    return best
end

-- ===================== SILENT AIM HOOK =====================
pcall(function()
    old_namecall = hookmetamethod(game, "__namecall", function(self, ...)
        local method = getnamecallmethod()
        
        -- Intercepta o disparo e força o servidor a registrar no inimigo
        if S.silent_aim and (method == "InvokeServer" or method == "FireServer" or method == "Shoot") then
            local target = get_closest_target()
            if target then
                local args = {...}
                for i, v in pairs(args) do
                    if typeof(v) == "Vector3" or typeof(v) == "CFrame" then
                        args[i] = target.part.Position
                    elseif typeof(v) == "Instance" and v:IsA("BasePart") then
                        args[i] = target.part
                    elseif typeof(v) == "RaycastParams" then
                        -- Muitos jogos enviam RaycastParams no FireServer
                        v.FilterDescendantsInstances = { LocalPlayer.Character, target.plr.Character }
                    end
                end
                return old_namecall(self, table.unpack(args))
            end
        end
        return old_namecall(self, ...)
    end)
end)

-- ===================== LOOPS =====================
RunService.RenderStepped:Connect(function()
    -- ESP Logic
    if not S.esp then
        for _, d in pairs(esp_objects) do
            for _, obj in pairs(d) do if obj then obj.Visible = false end end
        end
    else
        for plr, d in pairs(esp_objects) do
            local show = plr.Parent and is_alive(plr)
            if show and S.team_check and same_team(plr, LocalPlayer) then show = false end
            if not show then
                for _, obj in pairs(d) do if obj then obj.Visible = false end end
                continue
            end

            local head = plr.Character:FindFirstChild("Head")
            local root = plr.Character:FindFirstChild("HumanoidRootPart")
            local hum = plr.Character:FindFirstChildOfClass("Humanoid")
            if not head or not root or not hum then continue end

            local top, top_on = world_to_screen(head.Position + Vector3.new(0, 0.8, 0))
            local bottom, bottom_on = world_to_screen(root.Position - Vector3.new(0, 2.5, 0))
            
            if not (top_on or bottom_on) then
                for _, obj in pairs(d) do if obj then obj.Visible = false end end
                continue
            end

            local h = math.abs(bottom.Y - top.Y)
            local w = h * 0.55
            local x = math.min(top.X, bottom.X) - w / 2
            local y = math.min(top.Y, bottom.Y)

            if S.box then
                d.box.Size = Vector2.new(w, h)
                d.box.Position = Vector2.new(x, y)
                d.box.Color = S.accent
                d.box.Visible = true
            else d.box.Visible = false end

            if S.health then
                local pct = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                local bar_h = h * pct
                d.hp_bg.Size = Vector2.new(3, h)
                d.hp_bg.Position = Vector2.new(x - 6, y)
                d.hp_bar.Size = Vector2.new(3, bar_h)
                d.hp_bar.Position = Vector2.new(x - 6, y + (h - bar_h))
                d.hp_bg.Visible = true
                d.hp_bar.Visible = true
            else
                d.hp_bg.Visible = false
                d.hp_bar.Visible = false
            end

            if S.name then
                d.name.Text = plr.Name
                d.name.Position = Vector2.new(x + w / 2, y - 16)
                d.name.Color = S.accent
                d.name.Visible = true
            else d.name.Visible = false end

            if S.distance then
                d.dist.Text = string.format("%dm", math.floor((root.Position - Camera.CFrame.Position).Magnitude))
                d.dist.Position = Vector2.new(x + w / 2, y + h + 4)
                d.dist.Color = Color3.fromRGB(200, 190, 220)
                d.dist.Visible = true
            else d.dist.Visible = false end

            if S.tracer then
                local s_pos, s_on = world_to_screen(head.Position)
                if s_on then
                    d.tracer.From = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y)
                    d.tracer.To = Vector2.new(s_pos.X, s_pos.Y)
                    d.tracer.Color = S.accent
                    d.tracer.Visible = true
                else
                    d.tracer.Visible = false
                end
            else d.tracer.Visible = false end
        end
    end

    -- FOV & Aim Logic
    if fov_circle then
        fov_circle.Position = Camera.ViewportSize / 2
        fov_circle.Radius = S.fov
        fov_circle.Visible = (S.aimbot or S.silent_aim) and not is_mouse_over_gui()
        fov_circle.Color = S.accent
    end

    if (S.aimbot or S.triggerbot) and not is_mouse_over_gui() then
        local target = get_closest_target()
        if target then
            if S.aimbot then
                local part_pos = target.part.Position
                if S.prediction > 0 and target.root then
                    part_pos = part_pos + (target.root.AssemblyLinearVelocity * S.prediction)
                end
                local goal = CFrame.lookAt(Camera.CFrame.Position, part_pos)
                Camera.CFrame = Camera.CFrame:Lerp(goal, S.smoothness)
            end
            if S.triggerbot then
                pcall(function() if mouse1click then mouse1click() end end)
            end
        end
    end
end)

-- Fly / Speed Logic (Sem física)
RunService.Heartbeat:Connect(function()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end

    if S.fly then
        hum.PlatformStand = true
        local move_dir = Vector3.new(
            (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0),
            (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or 0),
            (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0)
        )
        if move_dir.Magnitude > 0 then
            hrp.CFrame = hrp.CFrame + (Camera.CFrame.LookVector * move_dir.Z + Camera.CFrame.RightVector * move_dir.X + Vector3.new(0, move_dir.Y, 0)) * (S.fly_speed / 50)
        end
    else
        if hum.PlatformStand then hum.PlatformStand = false end
    end

    hum.WalkSpeed = S.speed and S.walk_speed or 16
end)

