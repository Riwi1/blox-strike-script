local function make_tab(name, order)
    local b = Instance.new("TextButton", tab_bar)
    b.Size = UDim2.new(1, -12, 0, 32)
    b.Position = UDim2.fromOffset(6, 8 + (order - 1) * 38)
    b.BackgroundColor3 = S.bg_light
    b.Text = "  " .. name
    b.TextXAlignment = Enum.TextXAlignment.Left
    b.Font = Enum.Font.GothamMedium
    b.TextSize = 13
    b.TextColor3 = S.text
    corner(b, 6)
    
    local page = Instance.new("Frame", content_scroll)
    page.Size = UDim2.new(1, 0, 0, 0)
    page.BackgroundTransparency = 1
    page.Visible = false
    page.AutomaticSize = Enum.AutomaticSize.Y
    page.LayoutOrder = order
    local page_layout = Instance.new("UIListLayout", page)
    page_layout.Padding = UDim.new(0, 6)
    
    tabs[name] = { button = b, page = page }
    
    b.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.page.Visible = false
            t.button.BackgroundColor3 = S.bg_light
        end
        page.Visible = true
        b.BackgroundColor3 = S.accent
    end)
    return page
end

