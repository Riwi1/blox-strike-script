        TweenService:Create(dot, TweenInfo.new(0.15), {Position = config[key] and UDim2.fromOffset(21, 2) or UDim2.fromOffset(3, 2)}):Play()
    end)
end

local function add_slider(page, label, key, min, max, decimals)
    local holder = Instance.new("Frame", page)
    holder.Size = UDim2.new(1, 0, 0, 52)
    holder.BackgroundColor3 = config.bg_alt
    holder.LayoutOrder = ui_order
    corner(holder, 6)
    ui_order = ui_order + 1
    
    local lbl = Instance.new("TextLabel", holder)
    lbl.Size = UDim2.new(1, -20, 0, 16)
    lbl.Position = UDim2.fromOffset(12, 5)
    lbl.BackgroundTransparency = 1
    lbl.Text = label .. ": " .. tostring(config[key])
    lbl.Font = Enum.Font.GothamMedium
    lbl.TextSize = 12
    lbl.TextColor3 = config.text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    
    local track = Instance.new("Frame", holder)
    track.Size = UDim2.new(1, -24, 0, 4)
    track.Position = UDim2.new(0, 12, 0, 34)
    track.BackgroundColor3 = config.bg_light
    corner(track, 2)
    
    local fill = Instance.new("Frame", track)
    fill.Size = UDim2.new((config[key] - min) / (max - min), 0, 1, 0)
    fill.BackgroundColor3 = config.accent
    corner(fill, 2)
    
    local knob = Instance.new("Frame", track)
    knob.Size = UDim2.fromOffset(12, 12)
    knob.Position = UDim2.new(fill.Size.X.Scale, -6, 0.5, -6)
    knob.BackgroundColor3 = config.text
    corner(knob, 6)
    
    local dragging = false
    track.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = true end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local rel = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local val = min + rel * (max - min)
            if decimals then val = math.floor(val * 10^decimals) / 10^decimals else val = math.floor(val) end
            config[key] = val
            fill.Size = UDim2.new(rel, 0, 1, 0)
            knob.Position = UDim2.new(rel, -6, 0.5, -6)
            lbl.Text = label .. ": " .. tostring(val)
        end
    end)
end

